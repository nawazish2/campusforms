# Next.js app. Run `npx convex dev` once and it writes this (and CONVEX_DEPLOYMENT)
# into .env.local for a local deployment. For a cloud deployment, copy the
# deployment URL from the Convex dashboard (Settings -> URL & Deploy Key).
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210

# Written by `npx convex dev`; tells the Convex CLI which deployment to use.
# CONVEX_DEPLOYMENT=anonymous:anonymous-campusforms

# Optional: absolute site URL used for metadata and share images.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# These are NOT read from .env.local. Set them on the Convex deployment:
#
#   npx convex env set SITE_URL http://localhost:3000   # your site's origin
#   npx convex env set AUTH_GOOGLE_ID <google client id>
#   npx convex env set AUTH_GOOGLE_SECRET <google client secret>
#   npx convex env set -- JWT_PRIVATE_KEY "<pkcs8 private key>"
#   npx convex env set JWKS '<jwks json>'
#
# JWT_PRIVATE_KEY and JWKS come from the key script in "Manual Setup" in the
# Convex Auth docs (https://labs.convex.dev/auth/setup/manual).
#
# Google OAuth client, authorized redirect URI:
#   <deployment HTTP actions URL>/api/auth/callback/google
#   e.g. https://fast-horse-123.convex.site/api/auth/callback/google
# ---------------------------------------------------------------------------
